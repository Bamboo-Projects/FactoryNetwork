{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Manifold",
  "scopeName": "source.manifold",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#selector" },
    { "include": "#duration" },
    { "include": "#number" },
    { "include": "#declaration" },
    { "include": "#control" },
    { "include": "#worker" },
    { "include": "#display" },
    { "include": "#source" },
    { "include": "#constant" },
    { "include": "#call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.manifold",
      "match": "//.*$"
    },
    "string": {
      "name": "string.quoted.double.manifold",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.manifold", "match": "\\\\." }
      ]
    },
    "selector": {
      "comment": "item:iron_ingot, fluid:water, tag:c/ingots, chemical:oxygen — und mit Stern als Muster",
      "name": "support.constant.selector.manifold",
      "match": "\\b(item|fluid|chemical|tag):[A-Za-z0-9_./*:-]+"
    },
    "duration": {
      "comment": "Die Einheit gehört zur Zahl: 5t, 30s, 2min, 1h",
      "name": "constant.numeric.duration.manifold",
      "match": "\\b[0-9]+(\\.[0-9]+)?(t|s|min|h)\\b"
    },
    "number": {
      "name": "constant.numeric.manifold",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "declaration": {
      "comment": "Was auf oberster Ebene stehen darf",
      "name": "keyword.declaration.manifold",
      "match": "\\b(fn|worker|group|multiblock|event|display|on|import)\\b"
    },
    "control": {
      "name": "keyword.control.manifold",
      "match": "\\b(if|else|for|in|while|break|continue|return|let|move|except|emit|await|where|timeout|sleep)\\b"
    },
    "worker": {
      "comment": "Die Wörter, die einen Worker beschreiben",
      "name": "keyword.other.worker.manifold",
      "match": "\\b(from|to|filter|maintain|rate|per|when|priority|strategy|overflow|members|devices)\\b"
    },
    "display": {
      "comment": "Die Zeilenarten einer Anzeige",
      "name": "entity.name.tag.display.manifold",
      "match": "\\b(title|row|text|progress|indicator|list|button)\\b"
    },
    "source": {
      "comment": "Woher ein Wert kommt — storage.count, network.energy",
      "name": "support.class.manifold",
      "match": "\\b(storage|crafting|world|network|workers|multiblocks)\\b"
    },
    "constant": {
      "name": "constant.language.manifold",
      "match": "\\b(true|false|it)\\b"
    },
    "call": {
      "name": "entity.name.function.manifold",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "operator": {
      "name": "keyword.operator.manifold",
      "match": "(==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>=!])"
    }
  }
}
